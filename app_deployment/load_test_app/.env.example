# Copy to .env for LOCAL headless runs (run_load_test.py / locust). In the deployed
# load-gen app these come from app.yaml / bundle env instead.

# Agent app under test (base URL, no trailing /invocations).
TARGET_HOST=https://REPLACE-with-agent-app-url.databricksapps.com

# M2M OAuth (service principal that can invoke the agent app). Required against a
# deployed app; omit for a local unauthenticated server.
DATABRICKS_HOST=https://REPLACE-with-workspace.cloud.databricks.com
DATABRICKS_CLIENT_ID=REPLACE-with-service-principal-client-id
DATABRICKS_CLIENT_SECRET=REPLACE-with-service-principal-secret

# Ramp shape (headless CLI passes these as flags; the app reads them as env).
MAX_USERS=300
STEP_SIZE=20
STEP_DURATION=30
